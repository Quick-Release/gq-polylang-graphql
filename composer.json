{
  "name": "getquick/gq-polylang-graphql",
  "description": "Exposes Polylang's languages and translations in WPGraphQL, for headless multilingual WordPress sites.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Quick-Release/gq-polylang-graphql",
  "support": {
    "issues": "https://github.com/Quick-Release/gq-polylang-graphql/issues",
    "source": "https://github.com/Quick-Release/gq-polylang-graphql"
  },
  "keywords": ["wordpress", "wordpress-plugin", "wpgraphql", "polylang", "multilingual", "headless"],
  "authors": [{ "name": "GETQUICK", "email": "support@getquick.io", "homepage": "https://getquick.io" }],
  "require": {
    "php": ">=7.4",
    "composer/installers": "^1.0 || ^2.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "phpstan/extension-installer": "^1.4",
    "wpsyntex/polylang-stubs": "^3.7",
    "axepress/wp-graphql-stubs": "^2.0"
  },
  "extra": { "installer-name": "gq-polylang-graphql" },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "archive": {
    "exclude": ["/.ddev", "/.github", "/tests", "/phpcs.xml.dist", "/phpstan.neon.dist", "/.gitignore", "/.gitattributes"]
  }
}
